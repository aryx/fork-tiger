# -*- sh -*-

# ----------------------------------------------------------------------------
# Patterns
# ----------------------------------------------------------------------------

# qc assembly files
*.s

# ocaml object files
*.o
*.cm*
*.annot
.depend
*.so
*.a

# latex object files
*.aux
*.brf
*.log
*.out
*.toc
*.bbl
*.blg

# syncweb
.md5sum_*

# ----------------------------------------------------------------------------
# Specific files
# ----------------------------------------------------------------------------

# dune
/_build

# pfff and tools
/TAGS

# yacc
/parsing/lexer.ml
/parsing/parser.ml
/parsing/parser.mli
/parsing/parser.output

/docs/literate/.Tiger.nwcache
/docs/literate/Tiger-*.pdf
/docs/literate/Tiger.tex
/docs/literate/lineage.dot
/docs/literate/lineage.pdf

# binaries

# MISC/graph_code.marshall
/graph_code.marshall
/graph_code.marshall.opti
/layer_graph_code.json
/Fig_graph_ml.pdf

