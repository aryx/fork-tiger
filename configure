#!/bin/sh
#config: to debug this script add also '-x' to the set below
set -eu

###############################################################################
# Prelude
###############################################################################
# This script was written by Claude Code.
#
# The goal of this script is to find an installed Quick C-- and write
# Makefile.config, so that building tiger end to end needs no knowledge of
# where anyone's qc-- checkout lives.
#
# qc-- installs itself into an opam switch - "make install" in that repo runs
# "dune install cmm" - so its binary lands in <prefix>/bin/qc and its run-time
# system in <prefix>/lib/cmm. This script locates the binary, derives the
# run-time directory from it, and checks that both are really there.
#
# Install qc-- first:
#   cd <qc-- checkout> && dune build && make install
#
# It also records the two things that follow from qc only emitting 32-bit x86:
# a cross toolchain to assemble and link its output, and, on a host that is
# not x86, an emulator to run the result. The same is then repeated, all
# optional, for every other backend qc-- itself supports (see qc --help):
# ppc, sparc and mips (32-bit), arm and riscv32 (32-bit, no FPU/no metrics
# mismatch respectively), and alpha/riscv64 (64-bit) - see runtime/Makefile
# and stdlib/Makefile's BACKEND sections for what each backend's byteorder/
# float/wordsize quirk actually requires of the C-- sources.
#
# This replaces configure.old, a Perl script from the original distribution.
#
# TODO:
#  - macOS, where the cross toolchain is not gcc-i686-linux-gnu
#  - let --prefix pick a qc-- that is not in an opam switch

###############################################################################
# Entry point
###############################################################################

# Parse options
QC=${QC:-}
CC32=${CC32:-}
RUN32=${RUN32:-}
CC_PPC=${CC_PPC:-}
RUN_PPC=${RUN_PPC:-}
CC_SPARC=${CC_SPARC:-}
RUN_SPARC=${RUN_SPARC:-}
CC_ALPHA=${CC_ALPHA:-}
RUN_ALPHA=${RUN_ALPHA:-}
CC_MIPS=${CC_MIPS:-}
RUN_MIPS=${RUN_MIPS:-}
CC_ARM=${CC_ARM:-}
RUN_ARM=${RUN_ARM:-}
CC_RISCV32=${CC_RISCV32:-}
RUN_RISCV32=${RUN_RISCV32:-}
CC_RISCV64=${CC_RISCV64:-}
RUN_RISCV64=${RUN_RISCV64:-}
for arg in "$@"; do
    case "$arg" in
        --qc=*)
            QC="${arg#--qc=}"
            ;;
        --cc32=*)
            CC32="${arg#--cc32=}"
            ;;
        --cc-ppc=*)
            CC_PPC="${arg#--cc-ppc=}"
            ;;
        --cc-sparc=*)
            CC_SPARC="${arg#--cc-sparc=}"
            ;;
        --cc-alpha=*)
            CC_ALPHA="${arg#--cc-alpha=}"
            ;;
        --cc-mips=*)
            CC_MIPS="${arg#--cc-mips=}"
            ;;
        --cc-arm=*)
            CC_ARM="${arg#--cc-arm=}"
            ;;
        --cc-riscv32=*)
            CC_RISCV32="${arg#--cc-riscv32=}"
            ;;
        --cc-riscv64=*)
            CC_RISCV64="${arg#--cc-riscv64=}"
            ;;
        --help|-h)
            echo "Usage: ./configure [options]"
            echo "  --qc=PATH         use this qc rather than searching for one"
            echo "  --cc32=CMD        the 32-bit x86 C compiler to use"
            echo "  --cc-ppc=CMD      the 32-bit ppc C compiler to use (for -ppc-elf)"
            echo "  --cc-sparc=CMD    the 32-bit sparc C compiler to use (for -sparc)"
            echo "  --cc-alpha=CMD    the 64-bit alpha C compiler to use (for -alpha)"
            echo "  --cc-mips=CMD     the 32-bit mipsel C compiler to use (for -mips)"
            echo "  --cc-arm=CMD      the 32-bit arm C compiler to use (for -arm)"
            echo "  --cc-riscv32=CMD  the 32-bit riscv32 C compiler to use (for -riscv32)"
            echo "  --cc-riscv64=CMD  the 64-bit riscv64 C compiler to use (for -riscv64)"
            echo "QC, CC32, RUN32 and, per backend, CC_<ARCH>/AR_<ARCH>/RUN_<ARCH>"
            echo "may also be set in the environment."
            exit 0
            ;;
        *)
            echo "Unknown option: $arg" >&2
            echo "Try: ./configure --help" >&2
            exit 1
            ;;
    esac
done

###############################################################################
# Find qc
###############################################################################

if [ -z "$QC" ]; then
    QC=`command -v qc 2>/dev/null || true`
fi
if [ -z "$QC" ] && command -v opam >/dev/null 2>&1; then
    PREFIX=`opam var prefix 2>/dev/null || true`
    if [ -n "$PREFIX" ] && [ -x "$PREFIX/bin/qc" ]; then
        QC="$PREFIX/bin/qc"
    fi
fi

if [ -z "$QC" ] || [ ! -x "$QC" ]; then
    echo "configure: cannot find qc" >&2
    echo "  install it:     cd <qc-- checkout> && dune build && make install" >&2
    echo "  or point at it: ./configure --qc=/path/to/qc" >&2
    exit 1
fi

# <prefix>/bin/qc gives <prefix>. pwd -P resolves symlinks, so a qc on PATH
# that is itself a link into a switch still yields the right prefix.
QCBIN=`cd "\`dirname "$QC"\`" && pwd -P`
PREFIX=`dirname "$QCBIN"`
QCLIB="$PREFIX/lib/cmm"

if [ ! -f "$QCLIB/qc--runtime.h" ]; then
    echo "configure: found qc at $QC but no run-time system at $QCLIB" >&2
    echo "  that directory should hold qc--runtime.h, pcmap.ld and the" >&2
    echo "  run-time sources; re-run 'make install' in the qc-- checkout" >&2
    exit 1
fi

###############################################################################
# The 32-bit x86 toolchain
###############################################################################
# qc only emits i386, so the host compiler cannot assemble or link its output
# whatever the host architecture is. Not gcc-multilib: multilib offers
# secondary ABIs of the host's own architecture family, which on arm64 means
# 32-bit ARM, not i386.

if [ -z "$CC32" ]; then
    CC32=i686-linux-gnu-gcc
fi
if ! command -v "$CC32" >/dev/null 2>&1; then
    echo "configure: warning: no $CC32 on PATH" >&2
    echo "  sudo apt install gcc-i686-linux-gnu libc6-dev-i386-cross" >&2
fi

# The matching archiver. A cross gcc is <triple>-gcc and its binutils are
# <triple>-ar, so derive one from the other; plain "ar" would build an archive
# the cross linker cannot read.
AR32=${AR32:-}
if [ -z "$AR32" ]; then
    case "$CC32" in
        *-gcc) AR32="${CC32%-gcc}-ar" ;;
        *)     AR32=ar ;;
    esac
fi

###############################################################################
# How to run a 32-bit binary
###############################################################################
# Named explicitly rather than relying on binfmt_misc, which is a host-wide
# kernel registration that a container inherits only by accident.

if [ -z "$RUN32" ]; then
    ARCH=`uname -m`
    case "$ARCH" in
        i?86 | x86_64)
            RUN32=
            ;;
        *)
            RUN32=`command -v qemu-i386 2>/dev/null || true`
            if [ -z "$RUN32" ]; then
                echo "configure: warning: $ARCH host and no qemu-i386 on PATH" >&2
                echo "  sudo apt install qemu-user" >&2
            fi
            ;;
    esac
fi

###############################################################################
# The other qc-- backends (all optional)
###############################################################################
# Same reasoning as CC32/AR32/RUN32 above, one block per backend qc--
# supports beyond its default x86 (see "qc --help"). Detection is
# best-effort only: unlike CC32, none of these is the primary backend, so a
# missing toolchain is a warning, not a configure failure - "make
# test-<arch>" (or demos/Makefile's per-arch targets) will simply fail
# later with a clearer message. AR_<ARCH> is derived from CC_<ARCH>'s first
# word the same way AR32 is derived from CC32, since several of these
# (sparc, arm, riscv32) carry extra flags after the compiler name.
#
# arg1 = display name, arg2 = var prefix, arg3 = default CC (may have
# flags), arg4 = apt hint, arg5 = default qemu binary, arg6 = uname -m
# patterns this arch is native on (RUN left empty there).
detect_backend() {
    name=$1; prefix=$2; default_cc=$3; apt_hint=$4; default_run=$5; native_pat=$6

    eval "cc=\${CC_$prefix:-}"
    eval "ar=\${AR_$prefix:-}"
    eval "run=\${RUN_$prefix:-}"

    if [ -z "$cc" ]; then cc=$default_cc; fi
    ccbin=${cc%% *}
    if ! command -v "$ccbin" >/dev/null 2>&1; then
        echo "configure: warning: no $ccbin on PATH (only needed for -$name)" >&2
        echo "  $apt_hint" >&2
    fi

    if [ -z "$ar" ]; then
        case "$ccbin" in
            *-gcc) ar="${ccbin%-gcc}-ar" ;;
            *)     ar=ar ;;
        esac
    fi

    if [ -z "$run" ]; then
        ARCH=`uname -m`
        case "$ARCH" in
            $native_pat)
                run=
                ;;
            *)
                run=`command -v "$default_run" 2>/dev/null || true`
                if [ -z "$run" ]; then
                    echo "configure: warning: $ARCH host and no $default_run on PATH (only needed for -$name)" >&2
                    echo "  sudo apt install qemu-user" >&2
                fi
                ;;
        esac
    fi

    eval "CC_$prefix=\$cc"
    eval "AR_$prefix=\$ar"
    eval "RUN_$prefix=\$run"
}

# ppc: 32-bit big-endian PowerPC (-ppc-elf).
detect_backend ppc-elf PPC "powerpc-linux-gnu-gcc" \
    "sudo apt install gcc-powerpc-linux-gnu libc6-dev-powerpc-cross" \
    qemu-ppc "ppc|ppc64|powerpc|powerpc64"

# sparc: 32-bit big-endian SPARC V8. Ubuntu ships no plain 32-bit
# sparc-linux-gnu cross toolchain, only sparc64-linux-gnu, which targets
# 32-bit SPARC V8 via -m32 (same biarch trick x86_64 hosts use for -m32
# i386) - so CC_SPARC is deliberately two words. Its -m32 output is
# SPARC32PLUS-flagged (v8plus) even though the instructions used are plain
# v8, so it needs qemu-sparc32plus, not plain qemu-sparc (which rejects it:
# "Invalid ELF image for this architecture").
detect_backend sparc SPARC "sparc64-linux-gnu-gcc -m32" \
    "sudo apt install gcc-sparc64-linux-gnu binutils-sparc64-linux-gnu libc6-dev-sparc64-cross libc6-dev-sparc-sparc64-cross gcc-multilib-sparc64-linux-gnu" \
    qemu-sparc32plus "sparc"

# alpha: 64-bit little-endian DEC Alpha. A real glibc cross toolchain
# exists, no freestanding workaround needed.
detect_backend alpha ALPHA "alpha-linux-gnu-gcc" \
    "sudo apt install gcc-alpha-linux-gnu binutils-alpha-linux-gnu libc6-dev-alpha-cross" \
    qemu-alpha "alpha"

# mips: 32-bit little-endian MIPS (mipsel) - qemu-mipsel, not qemu-mips
# (big-endian MIPS), matches CC_MIPS's own little-endian choice.
detect_backend mips MIPS "mipsel-linux-gnu-gcc" \
    "sudo apt install gcc-mipsel-linux-gnu binutils-mipsel-linux-gnu libc6-dev-mipsel-cross" \
    qemu-mipsel "mips|mipsel|mips64|mips64el"

# arm: 32-bit little-endian ARM. -march=armv7ve+fp: plain armv7-a has no
# integer divide instruction, needed once the backend started emitting
# "sdiv"; "+fp" is required too or cc1 refuses to compile at all
# ("-mfloat-abi=hard: selected architecture lacks an FPU").
# -fno-stack-protector: gcc's default stack-protector on this C code
# spuriously fires against tiger's runtime/stdlib C sources; see
# runtime/Makefile's BACKEND=arm comment.
detect_backend arm ARM "arm-linux-gnueabihf-gcc -march=armv7ve+fp -fno-stack-protector" \
    "sudo apt install gcc-arm-linux-gnueabihf libc6-dev-armhf-cross" \
    qemu-arm "arm*"

# riscv32: 32-bit little-endian RISC-V (RV32IMAC). Ubuntu ships no
# riscv32-linux-gnu glibc at all, so CC_RISCV32 is a bare-metal
# (gcc-riscv64-unknown-elf) compiler targeting rv32imac/ilp32 against
# picolibc instead of glibc. Only stdlib.o/gc.o get compiled with this at
# configure-derived-build time; the freestanding final link (crt0,
# -nostartfiles, plain ld instead of gcc) is handled directly in
# demos/Makefile and tests/run-tests.sh, not here - see their own comments.
detect_backend riscv32 RISCV32 "riscv64-unknown-elf-gcc -march=rv32imac -mabi=ilp32 --specs=picolibc.specs" \
    "sudo apt install gcc-riscv64-unknown-elf picolibc-riscv64-unknown-elf" \
    qemu-riscv32 "never-native-freestanding-target"

# riscv64: 64-bit little-endian RISC-V (RV64GC). A real glibc cross
# toolchain exists, no freestanding workaround needed - like alpha and
# unlike riscv32.
detect_backend riscv64 RISCV64 "riscv64-linux-gnu-gcc" \
    "sudo apt install gcc-riscv64-linux-gnu binutils-riscv64-linux-gnu libc6-dev-riscv64-cross" \
    qemu-riscv64 "riscv64"

###############################################################################
# Write Makefile.config
###############################################################################

cat > Makefile.config <<EOF
# generated by ./configure - do not edit, re-run configure instead

# Where to install tigerc
BINDIR=/usr/local/bin
MANDIR=/usr/local/man
LIBDIR=/usr/local/lib
SHAREDIR=/usr/local/share/tigerc

# Quick C--
QC=$QC
QCLIB=$QCLIB
# for "\$(CC32) -I \$(QCINCLUDE)" when compiling C against the run-time interface
QCINCLUDE=$QCLIB
# the linker script that places the .pcmap sections and defines
# Cmm_pc_map/Cmm_pc_map_limit around them; belongs on the link line
QCPCMAP=$QCLIB/pcmap.ld

# The 32-bit x86 toolchain, since qc only emits i386
CC32=$CC32
AR32=$AR32
# How to run the result; empty on an x86 host
RUN32=$RUN32

# The 32-bit ppc toolchain, for qc--'s -ppc-elf backend (optional)
CC_PPC=$CC_PPC
AR_PPC=$AR_PPC
# How to run the result; empty on a ppc host
RUN_PPC=$RUN_PPC

# The 32-bit sparc (V8) toolchain, for qc--'s -sparc backend (optional)
CC_SPARC=$CC_SPARC
AR_SPARC=$AR_SPARC
RUN_SPARC=$RUN_SPARC

# The 64-bit alpha toolchain, for qc--'s -alpha backend (optional)
CC_ALPHA=$CC_ALPHA
AR_ALPHA=$AR_ALPHA
RUN_ALPHA=$RUN_ALPHA

# The 32-bit mipsel toolchain, for qc--'s -mips backend (optional)
CC_MIPS=$CC_MIPS
AR_MIPS=$AR_MIPS
RUN_MIPS=$RUN_MIPS

# The 32-bit arm toolchain, for qc--'s -arm backend (optional)
CC_ARM=$CC_ARM
AR_ARM=$AR_ARM
RUN_ARM=$RUN_ARM

# The 32-bit riscv32 (bare-metal/picolibc) toolchain, for qc--'s -riscv32
# backend (optional)
CC_RISCV32=$CC_RISCV32
AR_RISCV32=$AR_RISCV32
RUN_RISCV32=$RUN_RISCV32

# The 64-bit riscv64 toolchain, for qc--'s -riscv64 backend (optional)
CC_RISCV64=$CC_RISCV64
AR_RISCV64=$AR_RISCV64
RUN_RISCV64=$RUN_RISCV64
EOF

echo "wrote Makefile.config"
echo "  QC           = $QC"
echo "  QCLIB        = $QCLIB"
echo "  CC32         = $CC32"
echo "  AR32         = $AR32"
echo "  RUN32        = ${RUN32:-(native)}"
echo "  CC_PPC       = $CC_PPC"
echo "  RUN_PPC      = ${RUN_PPC:-(native)}"
echo "  CC_SPARC     = $CC_SPARC"
echo "  RUN_SPARC    = ${RUN_SPARC:-(native)}"
echo "  CC_ALPHA     = $CC_ALPHA"
echo "  RUN_ALPHA    = ${RUN_ALPHA:-(native)}"
echo "  CC_MIPS      = $CC_MIPS"
echo "  RUN_MIPS     = ${RUN_MIPS:-(native)}"
echo "  CC_ARM       = $CC_ARM"
echo "  RUN_ARM      = ${RUN_ARM:-(native)}"
echo "  CC_RISCV32   = $CC_RISCV32"
echo "  RUN_RISCV32  = ${RUN_RISCV32:-(native)}"
echo "  CC_RISCV64   = $CC_RISCV64"
echo "  RUN_RISCV64  = ${RUN_RISCV64:-(native)}"
