#!/bin/sh
#config: to debug this script add also '-x' to the set below
set -eu

###############################################################################
# Prelude
###############################################################################
# This script was written by Claude Code.
#
# The goal of this script is to find an installed Quick C-- and write
# Makefile.config, so that building tiger end to end needs no knowledge of
# where anyone's qc-- checkout lives.
#
# qc-- installs itself into an opam switch - "make install" in that repo runs
# "dune install cmm" - so its binary lands in <prefix>/bin/qc and its run-time
# system in <prefix>/lib/cmm. This script locates the binary, derives the
# run-time directory from it, and checks that both are really there.
#
# Install qc-- first:
#   cd <qc-- checkout> && dune build && make install
#
# It also records the two things that follow from qc only emitting 32-bit x86:
# a cross toolchain to assemble and link its output, and, on a host that is
# not x86, an emulator to run the result. The same is then repeated, all
# optional, for every other backend qc-- itself supports (see qc --help):
# ppc, sparc and mips (32-bit), arm and riscv32 (32-bit, no FPU/no metrics
# mismatch respectively), and alpha/riscv64 (64-bit) - see runtime/Makefile
# and stdlib/Makefile's BACKEND sections for what each backend's byteorder/
# float/wordsize quirk actually requires of the C-- sources.
#
# claude: this script used to do its own toolchain detection here (a
# "detect_backend" reimplementing, almost line for line, qc--'s own
# configure - same package names, same apt hints, same native-uname-m
# patterns), just to know which cross-compiler/archiver/emulator to use
# per backend. qc-- grew its own "qc -<arch> -print-cc/-print-ar/
# -print-run/-available-archs" for exactly this - see qc--'s own
# docs/claude_notes/plan_toolchain_dispatcher.txt for the full story -
# so this script now does none of that itself: every CC_<ARCH>/AR_<ARCH>/
# RUN_<ARCH> below (including the primary CC32/AR32/RUN32) comes from
# asking qc, unless explicitly overridden on the command line or in the
# environment (an explicit override is not "detection", so that stays).
# This also means a future qc-- frontend gets the same toolchains for
# free, with no detection logic of its own to write or keep in sync.
#
# This replaces configure.old, a Perl script from the original distribution.
#
# arm64/amd64: qc-- grew real Linux/ELF backends for these (previously
# Mach-O-only) - see qc--'s own docs/claude_notes/notes_arm64.txt and
# notes_amd64.txt. Like -ppc/-ppc-mach-o, the pair now has two flags each:
# the bare name (-arm64, -amd64) is the Linux/ELF one - arm64 is in fact
# this host's own native architecture whenever it's aarch64 Linux (e.g.
# this dev box, or AWS Graviton), needing no cross toolchain or qemu at
# all there, same as x86 on an x86 host. The OLD macOS/Mach-O behaviour
# (native on Apple Silicon, cross-assembled via "clang -arch x86_64"
# under Rosetta 2 for amd64) moved to a separate, explicit
# -arm64-mach-o/-amd64-mach-o flag pair, queried only on a Darwin host
# (there is nothing meaningful to ask for a Mach-O backend anywhere else)
# - see the dedicated block below.
#
# claude: this script also asks qc for each backend's target metrics
# (byteorder/wordsize/float support, via "qc -<arch> -print-metrics") and
# writes the single XFORM class (none/big/arm/64) they imply into
# Makefile.config as XFORM_<ARCH> - see query_xform below and
# stdlib/Makefile's header for what each XFORM value means. This used to
# be a table hand-maintained separately in stdlib/Makefile, runtime/
# Makefile, demos/Makefile and tests/run-tests.sh (one copy each, updated
# by hand whenever a backend's metrics mattered); now there is exactly
# one place a human has to get it right (this script, mechanically, from
# what qc-- itself reports), and the four consumers just read
# Makefile.config like they already do for CC_<ARCH> etc.
#
# TODO:
#  - macOS CC32 (x86 needs i686-linux-gnu-gcc, which macOS has no
#    equivalent for - CC32 still defaults to the Linux cross-compiler name
#    and will just warn on macOS, same as any other missing optional
#    backend toolchain; -arm64-mach-o/-amd64-mach-o are macOS's own way to
#    get a working native/Rosetta backend instead)
#  - let --prefix pick a qc-- that is not in an opam switch

###############################################################################
# Entry point
###############################################################################

# Parse options
QC=${QC:-}
CC32=${CC32:-}
AR32=${AR32:-}
RUN32=${RUN32:-}
CC_PPC=${CC_PPC:-}
AR_PPC=${AR_PPC:-}
RUN_PPC=${RUN_PPC:-}
CC_SPARC=${CC_SPARC:-}
AR_SPARC=${AR_SPARC:-}
RUN_SPARC=${RUN_SPARC:-}
CC_ALPHA=${CC_ALPHA:-}
AR_ALPHA=${AR_ALPHA:-}
RUN_ALPHA=${RUN_ALPHA:-}
CC_MIPS=${CC_MIPS:-}
AR_MIPS=${AR_MIPS:-}
RUN_MIPS=${RUN_MIPS:-}
CC_ARM=${CC_ARM:-}
AR_ARM=${AR_ARM:-}
RUN_ARM=${RUN_ARM:-}
CC_RISCV32=${CC_RISCV32:-}
AR_RISCV32=${AR_RISCV32:-}
RUN_RISCV32=${RUN_RISCV32:-}
CC_RISCV64=${CC_RISCV64:-}
AR_RISCV64=${AR_RISCV64:-}
RUN_RISCV64=${RUN_RISCV64:-}
CC_ARM64=${CC_ARM64:-}
AR_ARM64=${AR_ARM64:-}
RUN_ARM64=${RUN_ARM64:-}
CC_AMD64=${CC_AMD64:-}
AR_AMD64=${AR_AMD64:-}
RUN_AMD64=${RUN_AMD64:-}
CC_ARM64_MACHO=${CC_ARM64_MACHO:-}
AR_ARM64_MACHO=${AR_ARM64_MACHO:-}
CC_AMD64_MACHO=${CC_AMD64_MACHO:-}
AR_AMD64_MACHO=${AR_AMD64_MACHO:-}
# claude: no more --cc-<arch>= flags, one per backend (there used to be
# 11 of them) - CC_<ARCH>/AR_<ARCH>/RUN_<ARCH> (CC32/AR32/RUN32 for the
# primary x86 backend) are still override-able, just via the environment
# only now, not a dedicated CLI flag each: an override is a rare escape
# hatch (everything is asked of qc by default - see query_backend below),
# not something worth this much per-backend flag-parsing/--help bulk for.
for arg in "$@"; do
    case "$arg" in
        --qc=*)
            QC="${arg#--qc=}"
            ;;
        --help|-h)
            echo "Usage: ./configure [options]"
            echo "  --qc=PATH  use this qc rather than searching for one"
            echo
            echo "QC, and per backend CC_<ARCH>/AR_<ARCH>/RUN_<ARCH> (CC32/AR32/RUN32 for the"
            echo "primary x86 backend), may be set in the environment. Any of these you don't"
            echo "set is asked of qc itself (qc -<arch> -print-cc/-print-ar/-print-run) rather"
            echo "than detected here - this script does no toolchain detection of its own."
            exit 0
            ;;
        *)
            echo "Unknown option: $arg" >&2
            echo "Try: ./configure --help" >&2
            exit 1
            ;;
    esac
done

###############################################################################
# Find qc
###############################################################################

if [ -z "$QC" ]; then
    QC=`command -v qc 2>/dev/null || true`
fi
if [ -z "$QC" ] && command -v opam >/dev/null 2>&1; then
    PREFIX=`opam var prefix 2>/dev/null || true`
    if [ -n "$PREFIX" ] && [ -x "$PREFIX/bin/qc" ]; then
        QC="$PREFIX/bin/qc"
    fi
fi

if [ -z "$QC" ] || [ ! -x "$QC" ]; then
    echo "configure: cannot find qc" >&2
    echo "  install it:     cd <qc-- checkout> && dune build && make install" >&2
    echo "  or point at it: ./configure --qc=/path/to/qc" >&2
    exit 1
fi

# <prefix>/bin/qc gives <prefix>. pwd -P resolves symlinks, so a qc on PATH
# that is itself a link into a switch still yields the right prefix.
QCBIN=`cd "\`dirname "$QC"\`" && pwd -P`
PREFIX=`dirname "$QCBIN"`
QCLIB="$PREFIX/lib/cmm"

if [ ! -f "$QCLIB/qc--runtime.h" ]; then
    echo "configure: found qc at $QC but no run-time system at $QCLIB" >&2
    echo "  that directory should hold qc--runtime.h, pcmap.ld and the" >&2
    echo "  run-time sources; re-run 'make install' in the qc-- checkout" >&2
    exit 1
fi

# claude: everything below asks $QC for toolchains via -print-cc/-print-ar/
# -print-run/-available-archs - fail clearly here rather than with a
# confusing "unknown option" further down if $QC predates those (e.g. an
# opam switch with an old qc-- build still installed).
if ! "$QC" -available-archs >/dev/null 2>&1; then
    echo "configure: found qc at $QC but it does not support -available-archs" >&2
    echo "  (too old - rebuild/reinstall qc--: cd <qc-- checkout> && dune build && make install)" >&2
    exit 1
fi
if ! "$QC" -print-metrics >/dev/null 2>&1; then
    echo "configure: found qc at $QC but it does not support -print-metrics" >&2
    echo "  (too old - rebuild/reinstall qc--: cd <qc-- checkout> && dune build && make install)" >&2
    exit 1
fi

###############################################################################
# Ask qc for a backend's toolchain
###############################################################################
# arg1 = display name (for -$name in messages and as the actual qc flag),
# arg2 = CC var name, arg3 = AR var name, arg4 = RUN var name. Each of the
# three is left alone if already set (explicit override, from the command
# line or the environment - not detection, so qc is not asked); otherwise
# queried from qc, which itself now does the real detection (see this
# script's own header comment). A backend qc found nothing for becomes
# NONE, a warning, not a configure failure - matches this script's
# previous behaviour for every backend, including the primary x86 one
# (qc--'s own configure only warns on a missing CCX86 too, not a hard
# failure, so there is nothing to special-case here).
#
# qc's stderr is discarded (not embedded in the warning message): a
# -print-* failure is an uncaught OCaml exception at the moment (raised
# from inside Arg.parse's own callback, before main_action's nicer
# "Failure s -> Logs.err" handling ever sees it), so its stderr is a full
# multi-line backtrace dump, not a clean one-liner - not worth surfacing
# here.
#
# AR is always re-queried with QC_AS set to whatever CC ended up being
# (even if CC came from an explicit override) rather than trusted from a
# separate, independent qc query - so AR always matches the CC this
# script (and its Makefiles) actually use, not qc's own unrelated
# default for that backend.
query_backend() {
    name=$1; ccvar=$2; arvar=$3; runvar=$4

    eval "cc=\${$ccvar}"
    eval "ar=\${$arvar}"
    eval "run=\${$runvar}"

    if [ -z "$cc" ]; then
        if cc=`"$QC" "-$name" -print-cc 2>/dev/null`; then
            :
        else
            echo "configure: warning: qc found no toolchain for -$name (only needed for that backend)" >&2
            cc=NONE
        fi
    fi

    if [ -z "$ar" ]; then
        if [ "$cc" = NONE ]; then
            ar=NONE
        else
            ar=`QC_AS="$cc" "$QC" "-$name" -print-ar`
        fi
    fi

    if [ -z "$run" ]; then
        if run=`"$QC" "-$name" -print-run 2>/dev/null`; then
            :
        else
            echo "configure: warning: qc found no emulator for -$name (only needed for that backend)" >&2
            run=NONE
        fi
    fi

    eval "$ccvar=\$cc"
    eval "$arvar=\$ar"
    eval "$runvar=\$run"
}

###############################################################################
# Ask qc for a backend's target metrics, translate to this repo's XFORM
###############################################################################
# claude: byteorder/wordsize/float-support are properties of the backend
# itself, not of whatever toolchain happens to be installed on this host -
# unlike query_backend's CC/AR/RUN, -print-metrics needs no cross
# toolchain to answer and so is asked unconditionally for every backend,
# regardless of whether query_backend found a real CC for it. Reduces the
# three raw fields to the single XFORM class stdlib/Makefile, runtime/
# Makefile, demos/Makefile and tests/run-tests.sh already branch on (see
# stdlib/Makefile's header for the fuller reasoning behind each case):
#   64   - wordsize (equivalently pointersize here) is 64 bits - takes
#          priority over the other two: every 64-bit backend below is
#          also little-endian with an FPU, so this never has to arbitrate
#          a real conflict, just picks the one that needs the bigger
#          rewrite when more than one property differs from x86's own
#   big  - byteorder is big-endian
#   arm  - no floating-point support
#   none - none of the above (already matches qc--'s bits32-little-ieee754
#          default, same as x86 itself)
query_xform() {
    name=$1
    metrics=`"$QC" "-$name" -print-metrics` || {
        echo "configure: qc -$name -print-metrics failed - can't happen \
for a backend -available-archs didn't already refuse to list" >&2
        exit 1
    }
    byteorder=`echo "$metrics" | sed -n 's/^byteorder //p'`
    wordsize=`echo "$metrics"  | sed -n 's/^wordsize //p'`
    float=`echo "$metrics"     | sed -n 's/^float //p'`
    if [ "$wordsize" = 64 ]; then
        echo 64
    elif [ "$byteorder" = big ]; then
        echo big
    elif [ "$float" = none ]; then
        echo arm
    else
        echo none
    fi
}

###############################################################################
# The 32-bit x86 toolchain (the primary backend)
###############################################################################
# qc only emits i386, so the host compiler cannot assemble or link its
# output whatever the host architecture is. Same query_backend as every
# other backend below, just under the CC32/AR32/RUN32 names this script's
# Makefiles already expect (not CC_X86/AR_X86/RUN_X86 - an existing
# naming quirk, not introduced here).
query_backend x86 CC32 AR32 RUN32

###############################################################################
# The other qc-- backends (all optional)
###############################################################################
# Same query_backend as x86 above, one call per backend qc-- supports
# beyond its default x86 (see "qc --help" or "qc -available-archs").
query_backend ppc      CC_PPC     AR_PPC     RUN_PPC
query_backend sparc     CC_SPARC   AR_SPARC   RUN_SPARC
query_backend alpha     CC_ALPHA   AR_ALPHA   RUN_ALPHA
query_backend mips      CC_MIPS    AR_MIPS    RUN_MIPS

# claude: -fno-stack-protector is not part of what qc queried for -arm
# (qc-- itself has no need for it - this is specific to tiger's own
# runtime/stdlib C sources spuriously tripping gcc's default stack
# protector on this toolchain, see runtime/Makefile's BACKEND=arm
# comment) so it is appended here rather than asked of qc, same as this
# script always did - but only when CC_ARM wasn't already set explicitly
# (an override is trusted as given, unchanged from before).
cc_arm_was_set=false
[ -n "$CC_ARM" ] && cc_arm_was_set=true
query_backend arm       CC_ARM     AR_ARM     RUN_ARM
if [ "$cc_arm_was_set" = false ] && [ "$CC_ARM" != NONE ]; then
    CC_ARM="$CC_ARM -fno-stack-protector"
fi

query_backend riscv32   CC_RISCV32 AR_RISCV32 RUN_RISCV32
query_backend riscv64   CC_RISCV64 AR_RISCV64 RUN_RISCV64
query_backend arm64     CC_ARM64   AR_ARM64   RUN_ARM64
query_backend amd64     CC_AMD64   AR_AMD64   RUN_AMD64

# claude: XFORM32 (not XFORM_X86) to match CC32/AR32/RUN32's own existing
# naming quirk for the primary x86 backend - Makefile.backends' ccvar
# table derives every XFORM_<ARCH>/AR_<ARCH>/RUN_<ARCH> name from the
# corresponding CC_<ARCH> name by prefix substitution, so this has to
# follow the same irregular x86 spelling for that derivation to hold.
XFORM32=`query_xform x86`
XFORM_PPC=`query_xform ppc`
XFORM_SPARC=`query_xform sparc`
XFORM_ALPHA=`query_xform alpha`
XFORM_MIPS=`query_xform mips`
XFORM_ARM=`query_xform arm`
XFORM_RISCV32=`query_xform riscv32`
XFORM_RISCV64=`query_xform riscv64`
XFORM_ARM64=`query_xform arm64`
XFORM_AMD64=`query_xform amd64`
# claude: unlike CC_ARM64_MACHO/CC_AMD64_MACHO below, these two need no
# Darwin gating - -print-metrics answers from qc--'s own OCaml-side
# Target.t, not from probing this host's toolchain, so it works the same
# on every host (verified: matches arm64/amd64's own XFORM exactly, as
# expected - same 64-bit little-endian ieee754 target, just a different
# object format).
XFORM_ARM64_MACHO=`query_xform arm64-mach-o`
XFORM_AMD64_MACHO=`query_xform amd64-mach-o`

# arm64-mach-o / amd64-mach-o: the OLD Mach-O/Darwin-only behaviour arm64/
# amd64 used to mean before qc-- grew the Linux/ELF pair above - still
# real, just demoted to an explicit flag (mirrors qc--'s own configure).
# Only worth asking about on a Darwin host: arm64-mach-o is native there
# (no cross toolchain, no qemu - Mach-O has no qemu-user equivalent),
# amd64-mach-o cross-assembles via "clang -arch x86_64" and runs under
# Rosetta 2 (or natively on an actual Intel Mac) - either way with no
# separate wrapper command (qc's own -print-run agrees: always native for
# both), so RUN_ARM64_MACHO/RUN_AMD64_MACHO don't exist as variables at
# all here, same as before. Unlike every backend above, qc's own
# -arm64-mach-o/-amd64-mach-o cc is a fixed default ("clang"/"clang -arch
# x86_64"), not something ./configure in qc-- itself probed for - so it
# is not guaranteed to actually be on PATH the way query_backend's other
# callers are; this script still checks that much itself (a narrow
# existence check on qc's own answer, not a re-detection of what that
# answer should be).
if [ "`uname -s`" = "Darwin" ]; then
    if [ -z "$CC_ARM64_MACHO" ]; then
        CC_ARM64_MACHO=`"$QC" -arm64-mach-o -print-cc`
    fi
    if ! command -v "${CC_ARM64_MACHO%% *}" >/dev/null 2>&1; then
        echo "configure: warning: no $CC_ARM64_MACHO on PATH (only needed for -arm64-mach-o)" >&2
        echo "  install the Xcode command line tools: xcode-select --install" >&2
    fi
    if [ -z "$AR_ARM64_MACHO" ]; then
        AR_ARM64_MACHO=`QC_AS="$CC_ARM64_MACHO" "$QC" -arm64-mach-o -print-ar`
    fi

    if [ -z "$CC_AMD64_MACHO" ]; then
        CC_AMD64_MACHO=`"$QC" -amd64-mach-o -print-cc`
    fi
    if ! command -v "${CC_AMD64_MACHO%% *}" >/dev/null 2>&1; then
        echo "configure: warning: no ${CC_AMD64_MACHO%% *} on PATH (only needed for -amd64-mach-o)" >&2
        echo "  install the Xcode command line tools: xcode-select --install" >&2
    fi
    if [ -z "$AR_AMD64_MACHO" ]; then
        AR_AMD64_MACHO=`QC_AS="$CC_AMD64_MACHO" "$QC" -amd64-mach-o -print-ar`
    fi
fi

###############################################################################
# Pick the default backend for plain "make"/"make test"
###############################################################################
# claude: every Makefile/script in this repo hardcodes "x86" as ITS OWN
# default (BACKEND ?= x86 in stdlib/Makefile, runtime/Makefile; BACKEND=x86
# in demos/Makefile; BACKEND=${BACKEND:-x86} in tests/run-tests.sh) - none
# of that changes here, so running any of those directly (or with an
# explicit BACKEND=...) behaves exactly as before, unchanged, on every
# host. This section only picks what the TOP-LEVEL Makefile's own "all"/
# "test" targets pass down, so that a plain "./configure && make"/"make
# test" - the very first thing CLAUDE.md's own Quick Start says to run -
# actually works on a host where x86 fundamentally cannot: CC32 defaults
# to a Linux-only cross-compiler (i686-linux-gnu-gcc) that has no macOS
# equivalent, so x86 was never going to build there no matter what a user
# typed. On a genuine Apple Silicon Mac (arm64 host, no CC32 on PATH),
# default to arm64-mach-o instead - the one backend that's actually
# guaranteed to build there (native, no cross toolchain). Every other
# combination (Linux hosts, or a Mac with CC32 somehow installed) keeps
# the original x86 default untouched. Consults $CC32/$CC_ARM64_MACHO
# (query_backend's own results above) rather than re-probing "command -v"
# itself - CC32 = NONE is query_backend's own way of saying "not found",
# same meaning here as everywhere else.
#
# Must check `uname -s` = Darwin too, not just `uname -m` = arm64 - plain
# "arm64" now means qc--'s Linux/ELF backend (see this script's own header
# comment) - a Linux arm64 host (e.g. AWS Graviton) can easily have no i686
# cross toolchain either, and would wrongly match on CPU architecture
# alone, defaulting to arm64-mach-o, a backend that cannot link against
# that host's ELF/glibc at all. (On such a host, arm64 - the ELF backend -
# is in fact the right native default already, no special-casing needed:
# it falls through to the same "keeps the original x86 default" branch
# below only because CC32 being absent alone isn't sufficient reason to
# override x86 on Linux - a user there can already say BACKEND=arm64
# explicitly, or "./configure --cc32=..." to fix x86 instead.)
if [ "$CC32" = NONE ] \
   && [ "`uname -s`" = "Darwin" ] && [ "`uname -m`" = "arm64" ] \
   && command -v "${CC_ARM64_MACHO%% *}" >/dev/null 2>&1; then
    DEFAULT_BACKEND=arm64-mach-o
else
    DEFAULT_BACKEND=x86
fi

###############################################################################
# Write Makefile.config
###############################################################################

cat > Makefile.config <<EOF
# generated by ./configure - do not edit, re-run configure instead

# What the TOP-LEVEL Makefile's own "all"/"test" targets build when no
# BACKEND is given - see this script's own "Pick the default backend"
# comment. Every other Makefile/script in this repo keeps defaulting to
# x86 on its own, regardless of this value.
DEFAULT_BACKEND=$DEFAULT_BACKEND

# Where to install tigerc
BINDIR=/usr/local/bin
MANDIR=/usr/local/man
LIBDIR=/usr/local/lib
SHAREDIR=/usr/local/share/tigerc

# Quick C--
QC=$QC
QCLIB=$QCLIB
# for "\$(CC32) -I \$(QCINCLUDE)" when compiling C against the run-time interface
QCINCLUDE=$QCLIB
# the linker script that places the .pcmap sections and defines
# Cmm_pc_map/Cmm_pc_map_limit around them; belongs on the link line
QCPCMAP=$QCLIB/pcmap.ld

# The 32-bit x86 toolchain, since qc only emits i386
CC32=$CC32
AR32=$AR32
# How to run the result; empty on an x86 host
RUN32=$RUN32

# The 32-bit ppc toolchain, for qc--'s -ppc backend (optional)
CC_PPC=$CC_PPC
AR_PPC=$AR_PPC
# How to run the result; empty on a ppc host
RUN_PPC=$RUN_PPC

# The 32-bit sparc (V8) toolchain, for qc--'s -sparc backend (optional)
CC_SPARC=$CC_SPARC
AR_SPARC=$AR_SPARC
RUN_SPARC=$RUN_SPARC

# The 64-bit alpha toolchain, for qc--'s -alpha backend (optional)
CC_ALPHA=$CC_ALPHA
AR_ALPHA=$AR_ALPHA
RUN_ALPHA=$RUN_ALPHA

# The 32-bit mipsel toolchain, for qc--'s -mips backend (optional)
CC_MIPS=$CC_MIPS
AR_MIPS=$AR_MIPS
RUN_MIPS=$RUN_MIPS

# The 32-bit arm toolchain, for qc--'s -arm backend (optional)
CC_ARM=$CC_ARM
AR_ARM=$AR_ARM
RUN_ARM=$RUN_ARM

# The 32-bit riscv32 (bare-metal/picolibc) toolchain, for qc--'s -riscv32
# backend (optional)
CC_RISCV32=$CC_RISCV32
AR_RISCV32=$AR_RISCV32
RUN_RISCV32=$RUN_RISCV32

# The 64-bit riscv64 toolchain, for qc--'s -riscv64 backend (optional)
CC_RISCV64=$CC_RISCV64
AR_RISCV64=$AR_RISCV64
RUN_RISCV64=$RUN_RISCV64

# The 64-bit arm64 toolchain, for qc--'s -arm64 backend (Linux/ELF,
# optional; native on an aarch64-linux host)
CC_ARM64=$CC_ARM64
AR_ARM64=$AR_ARM64
RUN_ARM64=$RUN_ARM64

# The 64-bit amd64 toolchain, for qc--'s -amd64 backend (Linux/ELF, optional)
CC_AMD64=$CC_AMD64
AR_AMD64=$AR_AMD64
RUN_AMD64=$RUN_AMD64

# The 64-bit arm64/amd64 toolchains, for qc--'s -arm64-mach-o/-amd64-mach-o
# backends (optional; macOS only - native for arm64, under Rosetta 2 for
# amd64 - empty on any other host, since there's nothing to ask qc about there)
CC_ARM64_MACHO=$CC_ARM64_MACHO
AR_ARM64_MACHO=$AR_ARM64_MACHO
CC_AMD64_MACHO=$CC_AMD64_MACHO
AR_AMD64_MACHO=$AR_AMD64_MACHO

# The XFORM class each backend's target metrics (byteorder/wordsize/float
# support, from "qc -<arch> -print-metrics") imply for a hand-written or
# tigerc-emitted C-- source - see stdlib/Makefile's header for what each
# value (none/big/arm/64) means, and query_xform above for how it's
# derived. Read by stdlib/Makefile, runtime/Makefile, demos/Makefile
# (via Makefile.backends' ccvar table) and tests/run-tests.sh.
XFORM32=$XFORM32
XFORM_PPC=$XFORM_PPC
XFORM_SPARC=$XFORM_SPARC
XFORM_ALPHA=$XFORM_ALPHA
XFORM_MIPS=$XFORM_MIPS
XFORM_ARM=$XFORM_ARM
XFORM_RISCV32=$XFORM_RISCV32
XFORM_RISCV64=$XFORM_RISCV64
XFORM_ARM64=$XFORM_ARM64
XFORM_AMD64=$XFORM_AMD64
XFORM_ARM64_MACHO=$XFORM_ARM64_MACHO
XFORM_AMD64_MACHO=$XFORM_AMD64_MACHO
EOF

echo "wrote Makefile.config"
echo "  DEFAULT_BACKEND = $DEFAULT_BACKEND  (what plain 'make'/'make test' build)"
echo "  QC           = $QC"
echo "  QCLIB        = $QCLIB"
echo "  CC32         = $CC32"
echo "  AR32         = $AR32"
echo "  RUN32        = ${RUN32:-(native)}"
echo "  CC_PPC       = $CC_PPC"
echo "  RUN_PPC      = ${RUN_PPC:-(native)}"
echo "  CC_SPARC     = $CC_SPARC"
echo "  RUN_SPARC    = ${RUN_SPARC:-(native)}"
echo "  CC_ALPHA     = $CC_ALPHA"
echo "  RUN_ALPHA    = ${RUN_ALPHA:-(native)}"
echo "  CC_MIPS      = $CC_MIPS"
echo "  RUN_MIPS     = ${RUN_MIPS:-(native)}"
echo "  CC_ARM       = $CC_ARM"
echo "  RUN_ARM      = ${RUN_ARM:-(native)}"
echo "  CC_RISCV32   = $CC_RISCV32"
echo "  RUN_RISCV32  = ${RUN_RISCV32:-(native)}"
echo "  CC_RISCV64   = $CC_RISCV64"
echo "  RUN_RISCV64  = ${RUN_RISCV64:-(native)}"
echo "  CC_ARM64     = $CC_ARM64"
echo "  RUN_ARM64    = ${RUN_ARM64:-(native)}"
echo "  CC_AMD64     = $CC_AMD64"
echo "  RUN_AMD64    = ${RUN_AMD64:-(native)}"
if [ -n "$CC_ARM64_MACHO" ]; then
    echo "  CC_ARM64_MACHO = $CC_ARM64_MACHO  (native)"
fi
if [ -n "$CC_AMD64_MACHO" ]; then
    echo "  CC_AMD64_MACHO = $CC_AMD64_MACHO  (Rosetta 2)"
fi
echo "  XFORM (x86/ppc/sparc/alpha/mips/arm/riscv32/riscv64/arm64/amd64/arm64-mach-o/amd64-mach-o):"
echo "    $XFORM32 $XFORM_PPC $XFORM_SPARC $XFORM_ALPHA $XFORM_MIPS $XFORM_ARM $XFORM_RISCV32 $XFORM_RISCV64 $XFORM_ARM64 $XFORM_AMD64 $XFORM_ARM64_MACHO $XFORM_AMD64_MACHO"
