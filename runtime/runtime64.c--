/* claude: bits64 counterpart of runtime.c--, for a 64-bit qc-- backend
 * (e.g. alpha) selected via tigerc's -64 flag. Modeled directly on
 * ~/github/fork-c--/demos/hello_alpha.c--, which is the confirmed-working
 * reference for what a 64-bit C-- "main" needs: "wordsize 64 pointersize
 * 64" on the target line (Driver.compile checks this against the chosen
 * backend's own metrics and refuses on a mismatch - reproduced locally
 * with the installed 32-bit-only qc: "metrics of source code don't match
 * the target"), and an "address" hint on the pointer-typed argv param.
 *
 * Note: this only makes the .c-- itself consistent with what `tigerc -64`
 * emits and with alloc64.c--. gc.c's pointer-as-`unsigned` casts still
 * need a real 64-bit port (uintptr_t) before this can actually run
 * end-to-end, and the installed qc has no -alpha backend to link/test
 * against yet (see ~/github/fork-c--'s arch/alpha).
 */
target byteorder little wordsize 64 pointersize 64;
import tig_set_handler;
import gc_init;
import tiger_main;
import printf;
import getenv;
import atoi;
export main;

const HEAP_SIZE = 8192;

bits64 alloc_ptr;

section "data" {
  exn_msg           : bits8[] "unhandled exception %d\n\000";
  tiger_heapsize    : bits8[] "TIGER_HEAPSIZE\0";
  heapsize_msg      : bits8[] "heapsize %d\n\0";
}

foreign "C"
main(bits64 argc, "address" bits64 argv)
{
  bits64 rv;
  bits64 heapsize;
  bits64 env;

  env = foreign "C" getenv("address" tiger_heapsize);
  if (env != 0) {
    heapsize = foreign "C" atoi("address" env);
  } else {
    heapsize = HEAP_SIZE;
  }
  // foreign "C" printf("address" heapsize_msg, heapsize);
  alloc_ptr = foreign "C" gc_init(heapsize);

  tig_set_handler(k);
  rv = tiger_main(0) also cuts to k;
  foreign "C" return (rv);

continuation k(rv):
  foreign "C" printf(exn_msg, rv);
  foreign "C" return(-1);
}
