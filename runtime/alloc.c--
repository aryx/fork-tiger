/*s: alloc.c-- */
/*s: alloc.c--  */
target byteorder little;
import bits32 space_end;
import bits32 tig_gc;
export tig_alloc;
export tig_call_gc;
/*x: alloc.c--  */
bits32 alloc_ptr;
// claude: takes the pending allocation's size so tig_gc can grow the heap
// on the spot when collecting alone didn't free enough room for it - see
// runtime/gc.c's own comment on tig_gc for why that's needed (a copying
// collector frees at most heap_size bytes per cycle, so "gc once, proceed
// unconditionally" silently overflowed past space_end whenever a single
// object needed more than that).
tig_call_gc(bits32 size) {
  alloc_ptr = foreign "C" tig_gc(k, size) also cuts to k;
  return;
continuation k():
  return;
}
/*x: alloc.c--  */
tig_alloc(bits32 size) {
  bits32 p;
  p = 0;
  size = (size + 7) & 0xFFFFFFFC;
  if (alloc_ptr + size > bits32[space_end]) {
    tig_call_gc(size);
  }

  bits32[alloc_ptr] = size;
  p = alloc_ptr + 4;
  alloc_ptr = alloc_ptr + size;
  return(p);
}
/*e: alloc.c--  */
/*e: alloc.c-- */
